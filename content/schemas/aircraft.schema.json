{
  "$defs": {
    "ActuatorFile": {
      "additionalProperties": false,
      "description": "One surface actuator.",
      "properties": {
        "range_deg": {
          "description": "Travel, minimum then maximum.",
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array",
          "x-unit": "deg"
        },
        "rate_dps": {
          "description": "Rate limit.",
          "format": "double",
          "maximum": 1000.0,
          "minimum": 1.0,
          "type": "number",
          "x-unit": "deg/s"
        },
        "tau_s": {
          "description": "First-order time constant.",
          "format": "double",
          "maximum": 5.0,
          "minimum": 0.001,
          "type": "number",
          "x-unit": "s"
        }
      },
      "required": [
        "range_deg",
        "rate_dps",
        "tau_s"
      ],
      "type": "object"
    },
    "ActuatorsFile": {
      "additionalProperties": false,
      "description": "The actuators of the standard surfaces.",
      "properties": {
        "aileron": {
          "$ref": "#/$defs/ActuatorFile",
          "description": "Ailerons or flaperons (roll)."
        },
        "airbrake": {
          "$ref": "#/$defs/AirbrakeFile",
          "description": "Airbrake."
        },
        "gear": {
          "$ref": "#/$defs/GearActuatorFile",
          "description": "Landing gear."
        },
        "lef": {
          "$ref": "#/$defs/ActuatorFile",
          "description": "Leading-edge flaps."
        },
        "rudder": {
          "$ref": "#/$defs/ActuatorFile",
          "description": "Rudder (yaw)."
        },
        "stab": {
          "$ref": "#/$defs/ActuatorFile",
          "description": "Stabilator (pitch)."
        },
        "tef": {
          "$ref": "#/$defs/ActuatorFile",
          "description": "Trailing-edge flaps."
        }
      },
      "required": [
        "stab",
        "aileron",
        "rudder",
        "lef",
        "tef",
        "airbrake",
        "gear"
      ],
      "type": "object"
    },
    "AeroLimitsFile": {
      "additionalProperties": false,
      "description": "Aerodynamic references and operating limits.",
      "properties": {
        "flap_limit_mps": {
          "description": "Flap-extended speed limit.",
          "format": "double",
          "maximum": 1000.0,
          "minimum": 10.0,
          "type": "number",
          "x-unit": "m/s"
        },
        "gear_limit_mps": {
          "description": "Gear-extended speed limit.",
          "format": "double",
          "maximum": 1000.0,
          "minimum": 10.0,
          "type": "number",
          "x-unit": "m/s"
        },
        "max_mach": {
          "description": "Highest Mach the tables are meant for.",
          "format": "double",
          "maximum": 10.0,
          "minimum": 0.1,
          "type": "number"
        },
        "mmo": {
          "description": "Maximum operating Mach number.",
          "format": "double",
          "maximum": 10.0,
          "minimum": 0.1,
          "type": "number"
        },
        "n_max": {
          "description": "Structural positive load factor.",
          "format": "double",
          "maximum": 20.0,
          "minimum": 1.0,
          "type": "number",
          "x-unit": "g"
        },
        "n_max_by_config": {
          "$ref": "#/$defs/NMaxByConfigFile",
          "description": "Positive load factors with the gear or the flaps out."
        },
        "n_min": {
          "description": "Structural negative load factor (below zero).",
          "format": "double",
          "maximum": -0.1,
          "minimum": -20.0,
          "type": "number",
          "x-unit": "g"
        },
        "service_ceiling_m": {
          "description": "Service ceiling.",
          "format": "double",
          "maximum": 40000.0,
          "minimum": 100.0,
          "type": "number",
          "x-unit": "m"
        },
        "static_margin_mac": {
          "description": "Static margin as a fraction of the mean aerodynamic chord (negative if unstable).",
          "format": "double",
          "maximum": 0.5,
          "minimum": -0.5,
          "type": "number",
          "x-unit": "fraction of MAC"
        },
        "tables_ref": {
          "description": "Id of the aero tables (`namespace:aero/name`).",
          "type": "string"
        },
        "vmo_mps": {
          "description": "Maximum operating speed.",
          "format": "double",
          "maximum": 2000.0,
          "minimum": 10.0,
          "type": "number",
          "x-unit": "m/s"
        }
      },
      "required": [
        "tables_ref",
        "max_mach",
        "mmo",
        "vmo_mps",
        "service_ceiling_m",
        "n_max",
        "n_min",
        "n_max_by_config",
        "gear_limit_mps",
        "flap_limit_mps",
        "static_margin_mac"
      ],
      "type": "object"
    },
    "AirbrakeFile": {
      "additionalProperties": false,
      "description": "The airbrake actuator (moves as a fraction 0 to 1).",
      "properties": {
        "rate_per_s": {
          "description": "Rate limit.",
          "format": "double",
          "maximum": 100.0,
          "minimum": 0.01,
          "type": "number",
          "x-unit": "1/s"
        },
        "tau_s": {
          "description": "First-order time constant.",
          "format": "double",
          "maximum": 5.0,
          "minimum": 0.001,
          "type": "number",
          "x-unit": "s"
        }
      },
      "required": [
        "rate_per_s",
        "tau_s"
      ],
      "type": "object"
    },
    "CapsuleFile": {
      "additionalProperties": false,
      "description": "One hit volume: a capsule, a segment with a radius.",
      "properties": {
        "a_m": {
          "description": "One end of the segment in body axes.",
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array",
          "x-unit": "m"
        },
        "b_m": {
          "description": "The other end.",
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array",
          "x-unit": "m"
        },
        "id": {
          "description": "Name within the aircraft (`fuselage`, `wing_l`, ...).",
          "minLength": 1,
          "type": "string"
        },
        "radius_m": {
          "description": "Radius.",
          "format": "double",
          "maximum": 10.0,
          "minimum": 0.05,
          "type": "number",
          "x-unit": "m"
        }
      },
      "required": [
        "id",
        "a_m",
        "b_m",
        "radius_m"
      ],
      "type": "object"
    },
    "ContactFile": {
      "additionalProperties": false,
      "description": "One airframe contact point.",
      "properties": {
        "id": {
          "description": "Name within the aircraft (`nose_tip`, `tail`, `wing_l`, ...).",
          "minLength": 1,
          "type": "string"
        },
        "pos_m": {
          "description": "Position in body axes.",
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array",
          "x-unit": "m"
        }
      },
      "required": [
        "id",
        "pos_m"
      ],
      "type": "object"
    },
    "DamageFile": {
      "additionalProperties": false,
      "description": "Damage points and hit volumes.",
      "properties": {
        "capsules": {
          "description": "The hit volumes.",
          "items": {
            "$ref": "#/$defs/CapsuleFile"
          },
          "maxItems": 16,
          "minItems": 1,
          "type": "array"
        },
        "hp": {
          "description": "Hit points when new.",
          "format": "double",
          "maximum": 10000.0,
          "minimum": 1.0,
          "type": "number"
        },
        "joules_per_hp": {
          "description": "Energy that removes one hit point.",
          "format": "double",
          "maximum": 10000000.0,
          "minimum": 1.0,
          "type": "number",
          "x-unit": "J"
        }
      },
      "required": [
        "hp",
        "joules_per_hp",
        "capsules"
      ],
      "type": "object"
    },
    "EngineInstallFile": {
      "additionalProperties": false,
      "description": "One engine installation.",
      "properties": {
        "count": {
          "description": "Engines of this type at this position.",
          "format": "uint8",
          "maximum": 8,
          "minimum": 1,
          "type": "integer"
        },
        "position_m": {
          "description": "Thrust point in body axes.",
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array",
          "x-unit": "m"
        },
        "ref": {
          "description": "Id of the engine (`namespace:eng/name`).",
          "type": "string"
        }
      },
      "required": [
        "ref",
        "count",
        "position_m"
      ],
      "type": "object"
    },
    "EnvelopeFile": {
      "additionalProperties": false,
      "description": "The authored performance envelope (GDD 11.19, C.9).",
      "properties": {
        "points": {
          "description": "Target points.",
          "items": {
            "$ref": "#/$defs/EnvelopePointFile"
          },
          "maxItems": 64,
          "type": "array"
        }
      },
      "required": [
        "points"
      ],
      "type": "object"
    },
    "EnvelopePointFile": {
      "additionalProperties": false,
      "description": "One performance target.",
      "properties": {
        "alt_m": {
          "description": "Height above MSL.",
          "format": "double",
          "maximum": 30000.0,
          "minimum": -500.0,
          "type": "number",
          "x-unit": "m"
        },
        "config": {
          "description": "Configuration.",
          "enum": [
            "clean",
            "clean_mil",
            "clean_ab",
            "ref_ab",
            "to_flaps_ab",
            "ldg_brakes"
          ],
          "type": "string"
        },
        "id": {
          "description": "Name of the point.",
          "minLength": 1,
          "type": "string"
        },
        "mach": {
          "description": "Flight Mach number; required for the metrics measured at a given speed (`n_sust`,\n`turn_dps`).",
          "format": "double",
          "maximum": 5.0,
          "minimum": 0.0,
          "type": [
            "number",
            "null"
          ]
        },
        "mass_kg": {
          "description": "Aircraft mass.",
          "format": "double",
          "maximum": 1000000.0,
          "minimum": 1.0,
          "type": "number",
          "x-unit": "kg"
        },
        "metric": {
          "description": "What is measured.",
          "enum": [
            "max_mach",
            "stall_mps",
            "roc_mps",
            "n_sust",
            "turn_dps",
            "ff_kgps",
            "roll_m"
          ],
          "type": "string"
        },
        "requires": {
          "description": "A capability the point needs that the model may not have yet (ADR-31).",
          "enum": [
            "gear"
          ],
          "type": "string"
        },
        "tol_pct": {
          "description": "Tolerance.",
          "format": "double",
          "maximum": 50.0,
          "minimum": 0.1,
          "type": "number",
          "x-unit": "%"
        },
        "value": {
          "description": "Target, in the metric's unit (`max_mach`: Mach; `*_mps`: m/s; `turn_dps`: deg/s; ...).",
          "format": "double",
          "minimum": 0.0,
          "type": "number",
          "x-unit": "per metric"
        }
      },
      "required": [
        "id",
        "mass_kg",
        "alt_m",
        "config",
        "metric",
        "value",
        "tol_pct"
      ],
      "type": "object"
    },
    "FcsFile": {
      "additionalProperties": false,
      "description": "Flight-control data (GDD 11.11): limits and actuators, and the gains by reference.",
      "properties": {
        "actuators": {
          "$ref": "#/$defs/ActuatorsFile",
          "description": "Control-surface actuators (GDD 11.7)."
        },
        "gains_ref": {
          "description": "Id of the control-law gains (`namespace:fcs/name`).",
          "type": "string"
        },
        "limiters": {
          "$ref": "#/$defs/LimitersFile",
          "description": "Limiter settings."
        },
        "sas_required": {
          "description": "True if the airframe cannot be flown without stability augmentation.",
          "type": "boolean"
        }
      },
      "required": [
        "sas_required",
        "gains_ref",
        "limiters",
        "actuators"
      ],
      "type": "object"
    },
    "GearActuatorFile": {
      "additionalProperties": false,
      "description": "The landing-gear actuator.",
      "properties": {
        "transit_s": {
          "description": "Time for the gear to travel from up to down (or back).",
          "format": "double",
          "maximum": 60.0,
          "minimum": 0.5,
          "type": "number",
          "x-unit": "s"
        }
      },
      "required": [
        "transit_s"
      ],
      "type": "object"
    },
    "GearLegFile": {
      "additionalProperties": false,
      "description": "One landing-gear leg: a massless strut with a wheel at its end.",
      "properties": {
        "brake": {
          "description": "True if the wheel has a brake.",
          "type": "boolean"
        },
        "c_comp_nspm": {
          "description": "Damping while the strut compresses.",
          "format": "double",
          "maximum": 500000.0,
          "minimum": 0.0,
          "type": "number",
          "x-unit": "N s/m"
        },
        "c_ext_nspm": {
          "description": "Damping while the strut extends (usually the larger).",
          "format": "double",
          "maximum": 500000.0,
          "minimum": 0.0,
          "type": "number",
          "x-unit": "N s/m"
        },
        "id": {
          "description": "Name within the aircraft (`nose`, `main_l`, ...).",
          "minLength": 1,
          "type": "string"
        },
        "k_npm": {
          "description": "Spring rate.",
          "format": "double",
          "maximum": 5000000.0,
          "minimum": 1000.0,
          "type": "number",
          "x-unit": "N/m"
        },
        "main": {
          "description": "True for a main leg.",
          "type": "boolean"
        },
        "pos_m": {
          "description": "Wheel contact point with the leg fully extended, in body axes.",
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array",
          "x-unit": "m"
        },
        "steer_max_deg": {
          "description": "Largest steering angle (0 if the leg does not steer).",
          "format": "double",
          "maximum": 90.0,
          "minimum": 0.0,
          "type": "number",
          "x-unit": "deg"
        },
        "stroke_m": {
          "description": "Strut travel.",
          "format": "double",
          "maximum": 2.0,
          "minimum": 0.05,
          "type": "number",
          "x-unit": "m"
        }
      },
      "required": [
        "id",
        "pos_m",
        "stroke_m",
        "k_npm",
        "c_comp_nspm",
        "c_ext_nspm",
        "steer_max_deg",
        "brake",
        "main"
      ],
      "type": "object"
    },
    "GeometryFile": {
      "additionalProperties": false,
      "description": "Reference geometry.",
      "properties": {
        "bbox_m": {
          "description": "Bounding box: length, span, height.",
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array",
          "x-unit": "m"
        },
        "contacts": {
          "description": "Airframe points that can scrape the ground.",
          "items": {
            "$ref": "#/$defs/ContactFile"
          },
          "maxItems": 8,
          "type": "array"
        },
        "gear": {
          "description": "Landing-gear legs (GDD 11.13).",
          "items": {
            "$ref": "#/$defs/GearLegFile"
          },
          "maxItems": 4,
          "type": "array"
        },
        "mac_m": {
          "description": "Mean aerodynamic chord.",
          "format": "double",
          "maximum": 50.0,
          "minimum": 0.1,
          "type": "number",
          "x-unit": "m"
        },
        "ref_point_m": {
          "description": "Aerodynamic moment reference point in body axes.",
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array",
          "x-unit": "m"
        },
        "span_m": {
          "description": "Wing span.",
          "format": "double",
          "maximum": 100.0,
          "minimum": 0.1,
          "type": "number",
          "x-unit": "m"
        },
        "wing_area_m2": {
          "description": "Wing reference area.",
          "format": "double",
          "maximum": 1000.0,
          "minimum": 0.1,
          "type": "number",
          "x-unit": "m2"
        }
      },
      "required": [
        "wing_area_m2",
        "span_m",
        "mac_m",
        "ref_point_m",
        "bbox_m",
        "gear",
        "contacts"
      ],
      "type": "object"
    },
    "GunInstallFile": {
      "additionalProperties": false,
      "description": "An internal gun's installation.",
      "properties": {
        "harmonisation_mrad": {
          "description": "Angle between the barrel and the body's x axis in the pitch plane (nose up positive).",
          "format": "double",
          "maximum": 100.0,
          "minimum": -100.0,
          "type": "number",
          "x-unit": "mrad"
        },
        "muzzle_m": {
          "description": "Muzzle position in body axes; the barrel points along the body's x axis.",
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array",
          "x-unit": "m"
        },
        "ref": {
          "description": "Id of the gun (`namespace:wpn/name`).",
          "type": "string"
        },
        "rounds": {
          "description": "Rounds loaded at the start of a sortie.",
          "format": "uint16",
          "maximum": 5000,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "ref",
        "rounds",
        "muzzle_m",
        "harmonisation_mrad"
      ],
      "type": "object"
    },
    "InternalWeaponsFile": {
      "additionalProperties": false,
      "description": "The internal weapons of an aircraft.",
      "properties": {
        "gun": {
          "anyOf": [
            {
              "$ref": "#/$defs/GunInstallFile"
            },
            {
              "type": "null"
            }
          ],
          "description": "The internal gun."
        }
      },
      "type": "object"
    },
    "IrFile": {
      "additionalProperties": false,
      "description": "Infrared intensities, relative to the Kestrel's afterburner (GDD C.11).",
      "properties": {
        "aspect_front": {
          "description": "Factor on the engine intensity seen from the front.",
          "format": "double",
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        "aspect_side": {
          "description": "Factor on the engine intensity seen from the side.",
          "format": "double",
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        "engine_ab": {
          "description": "Engine in full afterburner.",
          "format": "double",
          "maximum": 10.0,
          "minimum": 0.0,
          "type": "number"
        },
        "engine_idle": {
          "description": "Engine at idle.",
          "format": "double",
          "maximum": 10.0,
          "minimum": 0.0,
          "type": "number"
        },
        "engine_mil": {
          "description": "Engine at military power.",
          "format": "double",
          "maximum": 10.0,
          "minimum": 0.0,
          "type": "number"
        },
        "skin_per_mach2": {
          "description": "Skin-heating intensity per Mach number squared.",
          "format": "double",
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        }
      },
      "required": [
        "engine_idle",
        "engine_mil",
        "engine_ab",
        "aspect_side",
        "aspect_front",
        "skin_per_mach2"
      ],
      "type": "object"
    },
    "LimitersFile": {
      "additionalProperties": false,
      "description": "Limiter settings.",
      "properties": {
        "alpha_limit_deg": {
          "description": "Angle-of-attack limit.",
          "format": "double",
          "maximum": 90.0,
          "minimum": 5.0,
          "type": "number",
          "x-unit": "deg"
        },
        "n_cmd_max": {
          "description": "Largest commanded load factor.",
          "format": "double",
          "maximum": 20.0,
          "minimum": 1.0,
          "type": "number",
          "x-unit": "g"
        },
        "roll_rate_max_dps": {
          "description": "Largest commanded roll rate.",
          "format": "double",
          "maximum": 720.0,
          "minimum": 10.0,
          "type": "number",
          "x-unit": "deg/s"
        }
      },
      "required": [
        "alpha_limit_deg",
        "n_cmd_max",
        "roll_rate_max_dps"
      ],
      "type": "object"
    },
    "LoadoutFile": {
      "additionalProperties": false,
      "description": "What hangs on the aircraft.",
      "properties": {
        "rails": {
          "description": "Launch rails.",
          "items": {
            "$ref": "#/$defs/RailFile"
          },
          "maxItems": 8,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "rails"
      ],
      "type": "object"
    },
    "MassFile": {
      "additionalProperties": false,
      "description": "Mass properties (GDD 11.9).",
      "properties": {
        "cg_empty_m": {
          "description": "Empty centre of gravity in body axes (x forward, y right, z down).",
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array",
          "x-unit": "m"
        },
        "empty_kg": {
          "description": "Empty mass.",
          "format": "double",
          "maximum": 1000000.0,
          "minimum": 1.0,
          "type": "number",
          "x-unit": "kg"
        },
        "fuel_density_kgpl": {
          "description": "Fuel density (JP-8 is about 0.80).",
          "format": "double",
          "maximum": 1.2,
          "minimum": 0.5,
          "type": "number",
          "x-unit": "kg/L"
        },
        "inertia_kgm2": {
          "description": "Empty roll, pitch and yaw inertia about the empty CG.",
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array",
          "x-unit": "kg m2"
        },
        "inertia_xz_kgm2": {
          "default": 0.0,
          "description": "Empty product of inertia XZ (zero for a symmetric mass distribution).",
          "format": "double",
          "type": "number",
          "x-unit": "kg m2"
        },
        "internal_fuel_kg": {
          "description": "Internal fuel: the sum of the tank capacities.",
          "format": "double",
