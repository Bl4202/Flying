    "TankFile": {
      "additionalProperties": false,
      "description": "One fuel tank.",
      "properties": {
        "capacity_kg": {
          "description": "Capacity.",
          "format": "double",
          "maximum": 1000000.0,
          "minimum": 1.0,
          "type": "number",
          "x-unit": "kg"
        },
        "feed_priority": {
          "description": "Feed order: lower feeds first; equal priorities feed together in proportion.",
          "format": "uint8",
          "maximum": 16,
          "minimum": 1,
          "type": "integer"
        },
        "id": {
          "description": "Name within the aircraft.",
          "minLength": 1,
          "type": "string"
        },
        "pos_m": {
          "description": "Centroid in body axes.",
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array",
          "x-unit": "m"
        }
      },
      "required": [
