              "maximum": 200.0,
              "minimum": 5.0,
              "type": "number",
              "x-unit": "mrad"
            },
            "id": {
              "description": "Layer name, unique in the HUD.",
              "type": "string"
            },
            "label_step_deg": {
              "description": "Angle between numbered bars.",
              "format": "double",
              "maximum": 90.0,
              "minimum": 1.0,
              "type": "number",
              "x-unit": "deg"
            },
            "step_deg": {
              "description": "Angle between ladder bars.",
              "format": "double",
              "maximum": 30.0,
              "minimum": 1.0,
              "type": "number",
              "x-unit": "deg"
            },
            "type": {
              "const": "pitch_ladder",
              "type": "string"
            }
          },
          "required": [
            "type",
            "id",
            "step_deg",
            "label_step_deg",
            "half_width_mrad",
            "gap_mrad",
            "declutter_above_deg"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "True heading, a horizontal tape.",
          "properties": {
            "at_mrad": {
              "description": "Centre of the tape.",
              "items": {
                "format": "double",
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array",
              "x-unit": "mrad"
            },
            "id": {
              "description": "Layer name, unique in the HUD.",
              "type": "string"
            },
            "label_deg": {
              "description": "Spacing of numbers.",
              "format": "double",
              "maximum": 90.0,
              "minimum": 1.0,
              "type": "number",
              "x-unit": "deg"
            },
            "span_mrad": {
              "description": "Length of the tape.",
              "format": "double",
              "maximum": 480.0,
              "minimum": 20.0,
              "type": "number",
              "x-unit": "mrad"
            },
            "tick_deg": {
              "description": "Spacing of ticks.",
