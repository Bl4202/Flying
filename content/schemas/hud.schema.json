              "maximum": 1000.0,
              "minimum": 10.0,
              "type": "number",
              "x-unit": "kn"
            }
          },
          "required": [
            "type",
            "id",
            "at_mrad",
            "span_mrad",
            "channel",
            "window_kn",
            "tick_kn",
            "label_kn",
            "mach_from"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
