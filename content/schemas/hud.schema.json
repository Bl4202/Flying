              "maximum": 90.0,
              "minimum": 10.0,
              "type": "number",
              "x-unit": "deg"
            },
            "gap_mrad": {
              "description": "Gap in the horizon line round the flight-path marker.",
              "format": "double",
              "maximum": 100.0,
              "minimum": 0.0,
              "type": "number",
              "x-unit": "mrad"
            },
            "half_width_mrad": {
              "description": "Half the length of a bar.",
