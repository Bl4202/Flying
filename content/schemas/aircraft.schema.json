{
  "$defs": {
    "ActuatorFile": {
      "additionalProperties": false,
      "description": "One surface actuator.",
      "properties": {
        "range_deg": {
          "description": "Travel, minimum then maximum.",
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array",
          "x-unit": "deg"
        },
        "rate_dps": {
          "description": "Rate limit.",
          "format": "double",
          "maximum": 1000.0,
          "minimum": 1.0,
          "type": "number",
          "x-unit": "deg/s"
        },
        "tau_s": {
          "description": "First-order time constant.",
          "format": "double",
          "maximum": 5.0,
          "minimum": 0.001,
          "type": "number",
          "x-unit": "s"
        }
      },
      "required": [
        "range_deg",
        "rate_dps",
        "tau_s"
      ],
      "type": "object"
    },
    "ActuatorsFile": {
      "additionalProperties": false,
      "description": "The actuators of the standard surfaces.",
      "properties": {
        "aileron": {
          "$ref": "#/$defs/ActuatorFile",
          "description": "Ailerons or flaperons (roll)."
        },
        "airbrake": {
          "$ref": "#/$defs/AirbrakeFile",
          "description": "Airbrake."
        },
        "lef": {
          "$ref": "#/$defs/ActuatorFile",
          "description": "Leading-edge flaps."
        },
        "rudder": {
          "$ref": "#/$defs/ActuatorFile",
          "description": "Rudder (yaw)."
        },
        "stab": {
          "$ref": "#/$defs/ActuatorFile",
          "description": "Stabilator (pitch)."
        },
        "tef": {
          "$ref": "#/$defs/ActuatorFile",
          "description": "Trailing-edge flaps."
        }
      },
      "required": [
        "stab",
        "aileron",
        "rudder",
        "lef",
        "tef",
        "airbrake"
      ],
      "type": "object"
    },
    "AeroLimitsFile": {
      "additionalProperties": false,
      "description": "Aerodynamic references and operating limits.",
      "properties": {
        "flap_limit_mps": {
          "description": "Flap-extended speed limit.",
          "format": "double",
          "maximum": 1000.0,
          "minimum": 10.0,
          "type": "number",
          "x-unit": "m/s"
        },
        "gear_limit_mps": {
          "description": "Gear-extended speed limit.",
          "format": "double",
          "maximum": 1000.0,
          "minimum": 10.0,
          "type": "number",
          "x-unit": "m/s"
        },
        "max_mach": {
          "description": "Highest Mach the tables are meant for.",
          "format": "double",
          "maximum": 10.0,
          "minimum": 0.1,
          "type": "number"
        },
        "mmo": {
          "description": "Maximum operating Mach number.",
          "format": "double",
          "maximum": 10.0,
          "minimum": 0.1,
          "type": "number"
        },
        "n_max": {
          "description": "Structural positive load factor.",
          "format": "double",
          "maximum": 20.0,
          "minimum": 1.0,
          "type": "number",
          "x-unit": "g"
        },
        "n_min": {
          "description": "Structural negative load factor (below zero).",
          "format": "double",
          "maximum": -0.1,
          "minimum": -20.0,
          "type": "number",
          "x-unit": "g"
        },
        "service_ceiling_m": {
          "description": "Service ceiling.",
          "format": "double",
          "maximum": 40000.0,
          "minimum": 100.0,
          "type": "number",
          "x-unit": "m"
        },
        "static_margin_mac": {
          "description": "Static margin as a fraction of the mean aerodynamic chord (negative if unstable).",
          "format": "double",
          "maximum": 0.5,
          "minimum": -0.5,
          "type": "number",
          "x-unit": "fraction of MAC"
        },
        "tables_ref": {
          "description": "Id of the aero tables (`namespace:aero/name`).",
          "type": "string"
        },
        "vmo_mps": {
          "description": "Maximum operating speed.",
          "format": "double",
          "maximum": 2000.0,
          "minimum": 10.0,
          "type": "number",
          "x-unit": "m/s"
        }
      },
      "required": [
        "tables_ref",
        "max_mach",
        "mmo",
        "vmo_mps",
        "service_ceiling_m",
        "n_max",
        "n_min",
        "gear_limit_mps",
        "flap_limit_mps",
        "static_margin_mac"
      ],
      "type": "object"
    },
    "AirbrakeFile": {
      "additionalProperties": false,
      "description": "The airbrake actuator (moves as a fraction 0 to 1).",
      "properties": {
        "rate_per_s": {
          "description": "Rate limit.",
          "format": "double",
          "maximum": 100.0,
          "minimum": 0.01,
          "type": "number",
          "x-unit": "1/s"
        },
        "tau_s": {
          "description": "First-order time constant.",
          "format": "double",
          "maximum": 5.0,
          "minimum": 0.001,
          "type": "number",
          "x-unit": "s"
        }
      },
      "required": [
        "rate_per_s",
        "tau_s"
      ],
      "type": "object"
    },
    "EngineInstallFile": {
      "additionalProperties": false,
      "description": "One engine installation.",
      "properties": {
        "count": {
          "description": "Engines of this type at this position.",
          "format": "uint8",
          "maximum": 8,
          "minimum": 1,
          "type": "integer"
        },
        "position_m": {
          "description": "Thrust point in body axes.",
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array",
          "x-unit": "m"
        },
        "ref": {
          "description": "Id of the engine (`namespace:eng/name`).",
          "type": "string"
        }
      },
      "required": [
        "ref",
        "count",
        "position_m"
      ],
      "type": "object"
    },
    "EnvelopeFile": {
      "additionalProperties": false,
      "description": "The authored performance envelope (GDD 11.19, C.9).",
      "properties": {
        "points": {
          "description": "Target points.",
          "items": {
            "$ref": "#/$defs/EnvelopePointFile"
          },
          "maxItems": 64,
          "type": "array"
        }
      },
      "required": [
        "points"
      ],
      "type": "object"
    },
    "EnvelopePointFile": {
      "additionalProperties": false,
      "description": "One performance target.",
      "properties": {
        "alt_m": {
          "description": "Height above MSL.",
          "format": "double",
          "maximum": 30000.0,
          "minimum": -500.0,
          "type": "number",
          "x-unit": "m"
        },
        "config": {
          "description": "Configuration.",
          "enum": [
            "clean",
            "clean_mil",
            "clean_ab",
            "ref_ab",
            "to_flaps_ab",
            "ldg_brakes"
          ],
          "type": "string"
        },
        "id": {
          "description": "Name of the point.",
          "minLength": 1,
          "type": "string"
        },
        "mass_kg": {
          "description": "Aircraft mass.",
          "format": "double",
          "maximum": 1000000.0,
          "minimum": 1.0,
          "type": "number",
          "x-unit": "kg"
        },
        "metric": {
          "description": "What is measured.",
          "enum": [
            "max_mach",
            "stall_mps",
            "roc_mps",
            "n_sust",
            "turn_dps",
            "ff_kgps",
            "roll_m"
          ],
          "type": "string"
        },
        "requires": {
          "description": "A capability the point needs that the model may not have yet (ADR-31).",
          "enum": [
            "gear"
          ],
          "type": "string"
        },
        "tol_pct": {
          "description": "Tolerance.",
          "format": "double",
          "maximum": 50.0,
          "minimum": 0.1,
          "type": "number",
          "x-unit": "%"
        },
        "value": {
          "description": "Target, in the metric's unit (`max_mach`: Mach; `*_mps`: m/s; `turn_dps`: deg/s; ...).",
          "format": "double",
          "minimum": 0.0,
          "type": "number",
          "x-unit": "per metric"
        }
      },
      "required": [
        "id",
        "mass_kg",
        "alt_m",
        "config",
        "metric",
        "value",
        "tol_pct"
      ],
      "type": "object"
    },
    "FcsFile": {
      "additionalProperties": false,
      "description": "Flight-control data (GDD 11.11; the control laws arrive in v0.1b).",
      "properties": {
        "actuators": {
          "$ref": "#/$defs/ActuatorsFile",
          "description": "Control-surface actuators (GDD 11.7)."
        },
        "limiters": {
          "$ref": "#/$defs/LimitersFile",
          "description": "Limiter settings."
        },
        "sas_required": {
          "description": "True if the airframe cannot be flown without stability augmentation.",
          "type": "boolean"
        }
      },
      "required": [
        "sas_required",
        "limiters",
        "actuators"
      ],
      "type": "object"
    },
    "GeometryFile": {
      "additionalProperties": false,
      "description": "Reference geometry.",
      "properties": {
        "bbox_m": {
          "description": "Bounding box: length, span, height.",
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array",
          "x-unit": "m"
        },
        "mac_m": {
          "description": "Mean aerodynamic chord.",
          "format": "double",
          "maximum": 50.0,
          "minimum": 0.1,
          "type": "number",
          "x-unit": "m"
        },
        "ref_point_m": {
          "description": "Aerodynamic moment reference point in body axes.",
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array",
          "x-unit": "m"
        },
        "span_m": {
          "description": "Wing span.",
          "format": "double",
          "maximum": 100.0,
          "minimum": 0.1,
          "type": "number",
          "x-unit": "m"
        },
        "wing_area_m2": {
          "description": "Wing reference area.",
          "format": "double",
          "maximum": 1000.0,
          "minimum": 0.1,
          "type": "number",
          "x-unit": "m2"
        }
      },
      "required": [
        "wing_area_m2",
        "span_m",
        "mac_m",
        "ref_point_m",
        "bbox_m"
      ],
      "type": "object"
    },
    "LimitersFile": {
      "additionalProperties": false,
      "description": "Limiter settings.",
      "properties": {
        "alpha_limit_deg": {
          "description": "Angle-of-attack limit.",
          "format": "double",
          "maximum": 90.0,
          "minimum": 5.0,
          "type": "number",
          "x-unit": "deg"
        },
        "n_cmd_max": {
          "description": "Largest commanded load factor.",
          "format": "double",
          "maximum": 20.0,
          "minimum": 1.0,
          "type": "number",
          "x-unit": "g"
        },
        "roll_rate_max_dps": {
          "description": "Largest commanded roll rate.",
          "format": "double",
          "maximum": 720.0,
          "minimum": 10.0,
          "type": "number",
          "x-unit": "deg/s"
        }
      },
      "required": [
        "alpha_limit_deg",
        "n_cmd_max",
        "roll_rate_max_dps"
      ],
      "type": "object"
    },
    "MassFile": {
      "additionalProperties": false,
      "description": "Mass properties (GDD 11.9).",
      "properties": {
        "cg_empty_m": {
          "description": "Empty centre of gravity in body axes (x forward, y right, z down).",
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array",
          "x-unit": "m"
        },
        "empty_kg": {
          "description": "Empty mass.",
          "format": "double",
          "maximum": 1000000.0,
          "minimum": 1.0,
          "type": "number",
          "x-unit": "kg"
        },
        "fuel_density_kgpl": {
          "description": "Fuel density (JP-8 is about 0.80).",
          "format": "double",
          "maximum": 1.2,
          "minimum": 0.5,
          "type": "number",
          "x-unit": "kg/L"
        },
        "inertia_kgm2": {
          "description": "Empty roll, pitch and yaw inertia about the empty CG.",
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array",
          "x-unit": "kg m2"
        },
        "inertia_xz_kgm2": {
          "default": 0.0,
          "description": "Empty product of inertia XZ (zero for a symmetric mass distribution).",
          "format": "double",
          "type": "number",
          "x-unit": "kg m2"
        },
        "internal_fuel_kg": {
          "description": "Internal fuel: the sum of the tank capacities.",
          "format": "double",
          "maximum": 1000000.0,
          "minimum": 1.0,
          "type": "number",
          "x-unit": "kg"
        },
        "max_landing_kg": {
          "description": "Maximum landing mass.",
          "format": "double",
          "maximum": 1000000.0,
          "minimum": 1.0,
          "type": "number",
          "x-unit": "kg"
        },
        "max_takeoff_kg": {
          "description": "Maximum take-off mass.",
          "format": "double",
          "maximum": 1000000.0,
          "minimum": 1.0,
          "type": "number",
          "x-unit": "kg"
        },
        "tanks": {
          "description": "Fuel tanks.",
          "items": {
            "$ref": "#/$defs/TankFile"
          },
          "maxItems": 16,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "empty_kg",
        "internal_fuel_kg",
        "max_takeoff_kg",
        "max_landing_kg",
        "cg_empty_m",
        "inertia_kgm2",
        "fuel_density_kgpl",
        "tanks"
      ],
      "type": "object"
    },
    "TankFile": {
      "additionalProperties": false,
      "description": "One fuel tank.",
      "properties": {
        "capacity_kg": {
          "description": "Capacity.",
          "format": "double",
          "maximum": 1000000.0,
          "minimum": 1.0,
          "type": "number",
          "x-unit": "kg"
        },
        "feed_priority": {
          "description": "Feed order: lower feeds first; equal priorities feed together in proportion.",
          "format": "uint8",
          "maximum": 16,
          "minimum": 1,
          "type": "integer"
        },
        "id": {
          "description": "Name within the aircraft.",
          "minLength": 1,
          "type": "string"
        },
        "pos_m": {
          "description": "Centroid in body axes.",
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array",
          "x-unit": "m"
        }
      },
      "required": [
        "id",
        "capacity_kg",
        "pos_m",
        "feed_priority"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One aircraft (GDD 12.2, A.2, Appendix C).",
  "properties": {
    "aero": {
      "$ref": "#/$defs/AeroLimitsFile",
      "description": "Aerodynamic references and operating limits."
    },
    "category": {
      "description": "Role.",
      "enum": [
        "light_fighter",
        "multirole_fighter",
        "heavy_fighter",
        "interceptor",
        "strike",
        "cas",
        "bomber",
        "electronic_warfare",
        "awacs",
        "carrier",
        "stealth",
        "experimental",
        "tanker",
        "transport",
        "uav"
      ],
      "type": "string"
    },
    "crew": {
      "description": "Crew count.",
      "format": "uint8",
      "maximum": 16,
      "minimum": 1,
      "type": "integer"
    },
    "engines": {
      "description": "Engine installations.",
      "items": {
        "$ref": "#/$defs/EngineInstallFile"
      },
      "maxItems": 4,
      "minItems": 1,
      "type": "array"
    },
    "envelope": {
      "$ref": "#/$defs/EnvelopeFile",
      "description": "Authored performance targets (GDD 11.19)."
    },
    "era": {
      "description": "Technology generation.",
      "enum": [
        "G1",
        "G2",
        "G3",
        "G4",
        "G4.5",
        "G5"
      ],
      "type": "string"
    },
    "fcs": {
      "$ref": "#/$defs/FcsFile",
      "description": "Flight-control data."
    },
    "geometry": {
      "$ref": "#/$defs/GeometryFile",
      "description": "Reference geometry."
    },
    "hardpoints": {
      "description": "Hardpoint count.",
      "format": "uint8",
      "maximum": 40,
      "minimum": 0,
      "type": "integer"
    },
    "id": {
      "description": "`namespace:type/name`, with namespace the pack id and type `ac`.",
      "type": "string"
    },
    "mass": {
      "$ref": "#/$defs/MassFile",
      "description": "Mass properties."
    },
    "name_key": {
      "description": "Key of the display name in the locale table.",
      "type": "string"
    },
    "schema": {
      "const": "aircraft/1",
      "description": "Format tag, always `aircraft/1`.",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "id",
    "name_key",
    "category",
    "era",
    "crew",
    "hardpoints",
    "mass",
    "geometry",
    "engines",
    "aero",
    "fcs",
    "envelope"
  ],
  "title": "AircraftFile",
  "type": "object"
}
