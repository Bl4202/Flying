  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`hud/1`: one aircraft's head-up display (GDD 54.13). Symbology is conformal and collimated by\nconstruction; the layers say which elements are drawn and where.",
  "properties": {
    "aircraft": {
      "description": "The aircraft this HUD belongs to, `core:ac/<name>`.",
      "type": "string"
    },
    "colour": {
      "description": "Default colour, `#rrggbb` (the player's palette setting overrides it).",
      "type": "string"
    },
    "eye_box_mm": {
      "description": "Eye box (width, height, depth) outside which the HUD fades.",
      "items": {
        "format": "double",
        "type": "number"
      },
      "maxItems": 3,
      "minItems": 3,
      "type": "array",
      "x-unit": "mm"
    },
    "font": {
      "description": "The stroke font, `core:fnt/<name>`.",
      "type": "string"
    },
    "glow_px": {
      "description": "Glow around a stroke.",
      "format": "double",
      "maximum": 4.0,
      "minimum": 0.0,
      "type": "number",
      "x-unit": "px"
    },
    "id": {
      "description": "`core:hud/<name>`.",
      "type": "string"
    },
    "layers": {
      "description": "The elements, drawn in this order.",
