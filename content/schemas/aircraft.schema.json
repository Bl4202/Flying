          "x-unit": "kg"
        },
        "max_landing_kg": {
          "description": "Maximum landing mass.",
          "format": "double",
          "maximum": 1000000.0,
          "minimum": 1.0,
          "type": "number",
          "x-unit": "kg"
        },
        "max_takeoff_kg": {
          "description": "Maximum take-off mass.",
          "format": "double",
          "maximum": 1000000.0,
          "minimum": 1.0,
          "type": "number",
          "x-unit": "kg"
        },
        "tanks": {
          "description": "Fuel tanks.",
          "items": {
            "$ref": "#/$defs/TankFile"
          },
          "maxItems": 16,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "empty_kg",
        "internal_fuel_kg",
        "max_takeoff_kg",
        "max_landing_kg",
