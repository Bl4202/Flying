          "minimum": 1.0,
          "type": "number",
          "x-unit": "g"
        },
        "gear": {
          "description": "Positive limit with the gear extended.",
          "format": "double",
          "maximum": 20.0,
          "minimum": 1.0,
          "type": "number",
          "x-unit": "g"
        }
      },
      "required": [
        "gear",
        "flaps"
      ],
      "type": "object"
    },
    "RailFile": {
      "additionalProperties": false,
      "description": "One launch rail.",
      "properties": {
        "pos_m": {
          "description": "Position of the store's centre in body axes.",
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array",
          "x-unit": "m"
        },
        "station": {
          "description": "Hardpoint number, counted from 1.",
