{
  "$defs": {
    "HudLayer": {
      "description": "One HUD element, by `type`. The registry of types is this enum: an unknown type is an error.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "The aircraft datum: a small cross at the boresight.",
          "properties": {
            "id": {
              "description": "Layer name, unique in the HUD.",
              "type": "string"
            },
            "size_mrad": {
              "description": "Size of the cross.",
              "format": "double",
              "maximum": 60.0,
              "minimum": 2.0,
              "type": "number",
              "x-unit": "mrad"
            },
            "type": {
              "const": "boresight",
              "type": "string"
            }
          },
          "required": [
            "type",
            "id",
            "size_mrad"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Where the aircraft is going (velocity vector), caged to the boresight at low speed.",
          "properties": {
            "cage_below_mps": {
              "description": "Below this ground speed the marker is caged to the boresight.",
              "format": "double",
              "maximum": 100.0,
              "minimum": 0.0,
              "type": "number",
              "x-unit": "m/s"
            },
            "id": {
              "description": "Layer name, unique in the HUD.",
              "type": "string"
            },
            "size_mrad": {
              "description": "Size of the circle.",
              "format": "double",
              "maximum": 60.0,
              "minimum": 2.0,
              "type": "number",
              "x-unit": "mrad"
            },
            "type": {
              "const": "flight_path_marker",
              "type": "string"
            }
          },
          "required": [
            "type",
            "id",
            "size_mrad",
            "cage_below_mps"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Pitch ladder with the horizon line.",
          "properties": {
            "declutter_above_deg": {
              "description": "Above this pitch the ladder is thinned to the numbered bars.",
